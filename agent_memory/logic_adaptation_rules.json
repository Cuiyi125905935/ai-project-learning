{
  "version": "1.0",
  "description": "Rules for adapting historical logic to current market scenarios",
  "scenario_dimensions": {
    "data_frequency": ["1min", "daily", "weekly", "tick"],
    "market_type": ["A_Share", "US_Stock", "Crypto", "Forex"],
    "indicator_type": ["Volume", "Price", "Momentum", "Volatility"]
  },
  "adaptation_engine": [
    {
      "source_scenario": {"frequency": "1min", "market": "US_Stock"},
      "target_scenario": {"frequency": "daily", "market": "A_Share"},
      "parameter_adjustments": {
        "find_peaks_distance": {"factor": 0.16, "reason": "Daily data has fewer points; adjust for trading days."},
        "vol_multiplier": {"factor": 0.67, "reason": "Daily volume is more stable than intraday spikes."}
      }
    }
  ],
  "data_characteristics": {
    "A_Share_Daily": {
      "avg_data_points_per_year": 240,
      "volatility_profile": "Lower frequency, higher gap risk"
    },
    "US_Stock_1min": {
      "avg_data_points_per_year": 98280,
      "volatility_profile": "High frequency, mean-reverting noise"
    }
  }
}
